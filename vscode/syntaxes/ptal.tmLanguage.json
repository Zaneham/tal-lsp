{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pTAL",
  "scopeName": "source.ptal",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#stdfunctions"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-type"
    },
    {
      "include": "#keywords-operator"
    },
    {
      "include": "#keywords-storage"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.bang.ptal",
          "match": "!.*$"
        },
        {
          "name": "comment.line.double-dash.ptal",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ptal",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ptal",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.ptal",
          "match": "^\\s*\\?.*$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ptal",
          "match": "\\b\\d+\\.\\d+([EeDd][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.ptal",
          "match": "%[Hh][0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.ptal",
          "match": "%[Bb][01]+"
        },
        {
          "name": "constant.numeric.octal.ptal",
          "match": "%[0-7]+"
        },
        {
          "name": "constant.numeric.decimal.ptal",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "stdfunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.ptal",
          "match": "(?i)\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.ptal",
          "match": "(?i)\\b(IF|THEN|ELSE|WHILE|DO|FOR|TO|DOWNTO|BY|UNTIL|CASE|OF|OTHERWISE|BEGIN|END|CALL|RETURN|GOTO|ASSERT|MOVE|SCAN|RSCAN)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.ptal",
          "match": "(?i)\\b(PROC|SUBPROC|FORWARD|EXTERNAL|MAIN|ENTRY|LITERAL|DEFINE|STRUCT|NAME|BLOCK|FILLER|BIT_FILLER|LABEL|FIELDALIGN|REFALIGNED|VOLATILE)\\b"
        }
      ]
    },
    "keywords-type": {
      "patterns": [
        {
          "name": "storage.type.ptal",
          "match": "(?i)\\b(STRING|INT|REAL|FIXED|UNSIGNED|BADDR|WADDR|EXTADDR|CBADDR|CWADDR|SGBADDR|SGWADDR|SGXBADDR|SGXWADDR|PROCADDR|PROCPTR)\\b"
        },
        {
          "name": "storage.type.ptal",
          "match": "(?i)\\bINT\\s*\\(\\s*32\\s*\\)"
        },
        {
          "name": "storage.type.ptal",
          "match": "(?i)\\bREAL\\s*\\(\\s*64\\s*\\)"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ptal",
          "match": "(?i)\\b(AND|OR|NOT|LAND|LOR|XOR)\\b"
        }
      ]
    },
    "keywords-storage": {
      "patterns": [
        {
          "name": "storage.modifier.ptal",
          "match": "(?i)\\b(GLOBAL|LOCAL|SUBLOCAL|CALLABLE|PRIV|VARIABLE|EXTENSIBLE|RESIDENT|INTERRUPT|READONLY|CODE|STORE|USE|DROP|STACK)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.ptal",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.ptal",
          "match": "<>|<=|>=|<<|>>"
        },
        {
          "name": "keyword.operator.unsigned.ptal",
          "match": "\\([+\\-*/]\\)"
        },
        {
          "name": "keyword.operator.ptal",
          "match": "[+\\-*/<>=@&]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.ptal",
          "match": "\\b[A-Za-z_^][A-Za-z0-9_^]*\\b"
        }
      ]
    }
  }
}